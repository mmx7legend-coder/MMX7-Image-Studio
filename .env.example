# GEMINI_API_KEY: Required for Gemini AI API calls (Background removal, Inpainting, AI Upscaler)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# STRIPE_PUBLISHABLE_KEY & STRIPE_SECRET_KEY: Optional for live payment processing (built-in secure sandbox test mode runs out-of-the-box)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# JWT_SECRET: Secret for signing session auth tokens (defaults to auto-generated local persistent salt)
JWT_SECRET="mmx7_studio_secure_jwt_secret_token"
